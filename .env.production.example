# =============================================================================
# Smart Option Backend — variáveis de ambiente de PRODUÇÃO
#
# Na VPS, copie este arquivo para ".env" na raiz do projeto e preencha os
# valores reais antes do primeiro deploy:
#   cp .env.production.example .env
#
# Toda variável usada pelo código está listada aqui — nada é lido de fora
# deste conjunto (validado por src/config/env.ts com zod; o processo recusa
# subir se faltar algo obrigatório). Guia de deploy completo em docs/deploy.md.
#
# Se algum valor começar com "$" (ex.: chaves de API da Asaas, formato
# "$aact_..."), coloque-o entre aspas simples ('...') — sem isso o Docker
# Compose tenta interpolar o "$" como se fosse uma variável e o valor vira
# string vazia silenciosamente (ver README, seção Troubleshooting).
#
# NUNCA commitar o ".env" real — só este arquivo de exemplo vai para o git.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
NODE_ENV=production
# docker-compose.prod.yml fixa APP_PORT=3000 dentro do container
# independentemente do que estiver aqui (precisa bater com o upstream do
# Nginx) — mantenha 3000 para não ter que editar nginx/nginx.conf também.
APP_PORT=3000
# URL pública real da API — usada para montar notification_urls de webhooks
# enviados à Asaas. Deve ser o domínio de produção com HTTPS.
API_BASE_PATH=https://api.byissa.dev

# --- Banco de dados (MySQL) --- [OBRIGATÓRIO] --------------------------------
# Em produção, docker-compose.prod.yml roda o próprio MySQL no mesmo compose
# (serviço "mysql") — DB_HOST é sobrescrito para "mysql" automaticamente pelo
# compose; o valor abaixo só importa se você apontar para um banco externo.
DB_HOST=mysql
DB_PORT=3306
DB_USER=smart_option
# Senha forte e única — evite o caractere "$" (ver nota no topo do arquivo)
# para não precisar lidar com aspas na hora de gerar o compose. Gere com:
# openssl rand -base64 24 | tr -d '/+=$'
DB_PASSWORD=
DB_DATABASE=smart_option

# --- Redis ---------------------------------------------------------------------
# Em produção o Redis roda no mesmo compose (serviço "redis"), sem porta
# publicada para o host — REDIS_URL é sobrescrito para "redis://redis:6379"
# automaticamente pelo docker-compose.prod.yml.
REDIS_URL=redis://redis:6379

# --- Autenticação / JWT --- [OBRIGATÓRIO] -------------------------------------
# Gere dois valores aleatórios FORTES e DIFERENTES entre si — nunca reaproveite
# os de desenvolvimento: openssl rand -hex 32
SECRET_KEY=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# --- Telegram Bot --- [OBRIGATÓRIO] -------------------------------------------
# Token do bot real de produção (BotFather) — nunca o mesmo token usado em
# desenvolvimento (o long polling só aceita um consumidor por token; ver
# docs/deploy.md, seção "O que este setup deliberadamente não cobre").
BOT_USER=
BOT_TOKEN=

# --- Logging / Monitoramento ---------------------------------------------------
# fatal | error | warn | info | debug | trace — "info" em produção.
# Observabilidade nesta versão do projeto é feita via logs estruturados
# (Pino/JSON, prontos para qualquer coletor — Loki, CloudWatch, etc. — ligar
# na camada de infraestrutura) e pelos endpoints GET /health (liveness) e
# GET /api/health (readiness: banco + Redis), usados por health checks
# externos/uptime monitoring. Não há variável de APM dedicada no momento —
# quando uma ferramenta (Sentry, Datadog etc.) for adotada, a env var
# correspondente entra aqui e em src/config/env.ts junto.
LOG_LEVEL=info

# --- CORS --- [OBRIGATÓRIO] ---------------------------------------------------
# Domínio real do painel admin em produção, separados por vírgula se houver mais de um.
CORS_ALLOWED_ORIGINS=https://painel.byissa.dev

# --- Rate limiting -------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Asaas Produção --- [OBRIGATÓRIO] -----------------------------------------
ASAAS_ENV=production
# Chave de API da conta Asaas em modo Produção (formato $aact_prod_...) —
# painel Asaas > Integrações > Chave de API. Lembre-se das aspas simples.
ASAAS_API_KEY=
# URL base da API — Produção é sempre api.asaas.com/v3 (NUNCA a de sandbox).
ASAAS_BASE_URL=https://api.asaas.com/v3
# Valor que você mesmo escolhe ao cadastrar o webhook no painel de Produção da
# Asaas — reenviado no header `asaas-access-token` em cada entrega, validado
# por comparação constant-time. Gere algo aleatório: openssl rand -hex 24
# (diferente do usado em sandbox/desenvolvimento).
ASAAS_WEBHOOK_TOKEN=

# --- Cloudflare (DNS/CDN da zona byissa.dev) ------------------------------
# O Cloudflare Tunnel é exclusivo de desenvolvimento local (ver README) — em
# produção o tráfego público chega via Nginx + TLS próprio (Let's Encrypt,
# docs/deploy.md), não pelo cloudflared. Estas variáveis existem só para
# manter o schema de ambiente idêntico entre dev/produção; CF_TUNNEL_DOMAIN
# documenta o domínio público real de produção para referência.
CF_TUNNEL_ID=
CF_TUNNEL_TOKEN=
CF_TUNNEL_DOMAIN=api.byissa.dev
CF_TUNNEL_HOST=localhost

###########################################################
# EMAIL
###########################################################

EMAIL_TYPE=resend

###########################################################
# SMTP
###########################################################

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=smart-option-contact@byissa.dev
SMTP_PASSWORD=production-placeholder

###########################################################
# RESEND
###########################################################

RESEND_API_KEY=production-placeholder

MAIL_FROM_NAME=Smart Option

MAIL_FROM_ADDRESS=smart-option@byissa.dev 