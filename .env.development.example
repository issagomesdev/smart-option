# =============================================================================
# Smart Option Backend — variáveis de ambiente de DESENVOLVIMENTO
#
# Copie este arquivo para ".env" na raiz do projeto e preencha os valores:
#   cp .env.development.example .env
#
# Toda variável usada pelo código está listada aqui — nada é lido de fora
# deste conjunto (validado por src/config/env.ts com zod; o processo recusa
# subir se faltar algo obrigatório). Variáveis marcadas [OBRIGATÓRIO] não têm
# valor padrão; as demais already funcionam com o padrão indicado se deixadas
# em branco.
#
# Se algum valor começar com "$" (ex.: chaves de API da Asaas, formato
# "$aact_..."), coloque-o entre aspas simples ('...') — sem isso o Docker
# Compose tenta interpolar o "$" como se fosse uma variável e o valor vira
# string vazia silenciosamente (ver README, seção Troubleshooting).
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
NODE_ENV=development
# Porta em que a API sobe — usada pelo processo Node, pelo mapeamento de porta
# do Docker Compose e pelo Cloudflare Tunnel. Nunca fixar em código: mude só aqui.
APP_PORT=3000
# URL pública base da API (usada para montar notification_urls de webhooks
# enviados à Asaas). Em dev normalmente não importa o valor exato.
API_BASE_PATH=http://localhost:3000

# --- Banco de dados (MySQL) --- [OBRIGATÓRIO: DB_HOST, DB_USER, DB_DATABASE] -
# Valores abaixo já compatíveis com o `docker-compose.dev.yml` local.
DB_HOST=localhost
DB_PORT=3306
DB_USER=smart_option
DB_PASSWORD=smart_option
DB_DATABASE=smart_option

# --- Redis ---------------------------------------------------------------
# Porta publicada pelo docker-compose.dev.yml (não confundir com REDIS_URL,
# que é o que a aplicação de fato usa para conectar).
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Autenticação / JWT --- [OBRIGATÓRIO: SECRET_KEY, JWT_REFRESH_SECRET] ----
# Gere valores aleatórios fortes mesmo em dev (ex.: openssl rand -hex 32).
# SECRET_KEY e JWT_REFRESH_SECRET DEVEM ser diferentes entre si.
SECRET_KEY=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# --- Telegram Bot --- [OBRIGATÓRIO] -------------------------------------------
# Crie um bot de teste dedicado com o @BotFather — nunca aponte o ambiente de
# desenvolvimento para o bot de produção.
BOT_USER=
BOT_TOKEN=

# --- Logging -------------------------------------------------------------------
# fatal | error | warn | info | debug | trace — "debug" é útil em dev.
LOG_LEVEL=debug

# --- CORS ----------------------------------------------------------------------
# Origens do painel admin local, separadas por vírgula. Vazio = nenhuma liberada.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting -------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Asaas Sandbox --- [OBRIGATÓRIO: ASAAS_API_KEY, ASAAS_WEBHOOK_TOKEN] -----
# Ambiente da Asaas usado — mantenha "sandbox" em desenvolvimento.
ASAAS_ENV=sandbox
# Chave de API da sua conta Asaas em modo Sandbox (formato $aact_hmlg_...) —
# painel Asaas Sandbox > Integrações > Chave de API. Lembre-se das aspas simples.
ASAAS_API_KEY=
# URL base da API — Sandbox é sempre api-sandbox.asaas.com/v3.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Valor que você mesmo escolhe ao cadastrar o webhook no painel Sandbox da
# Asaas — é reenviado no header `asaas-access-token` em cada webhook recebido,
# usado para validar que a entrega realmente veio da Asaas (comparação
# constant-time). Gere algo aleatório: openssl rand -hex 24.
ASAAS_WEBHOOK_TOKEN=

# --- Cloudflare Tunnel (expõe a API local para a Asaas conseguir entregar
# webhooks de verdade em desenvolvimento — ver README, seção "Cloudflare
# Tunnel") — [OPCIONAL: só necessário para `npm run tunnel`/`npm run dev:full`] -
# Preenchido automaticamente por "npm run tunnel"/"npm run dev:full" na
# primeira execução (cria o túnel nomeado e grava o ID aqui). Pode deixar em
# branco na primeira vez.
CF_TUNNEL_ID=
# Alternativa ao arquivo de credenciais gerado em cloudflared/credentials/ —
# normalmente não é necessário preencher em desenvolvimento.
CF_TUNNEL_TOKEN=
# Subdomínio público de desenvolvimento (zona byissa.dev).
CF_TUNNEL_DOMAIN=smartoptiondev.byissa.dev
# Para onde o cloudflared encaminha as requisições — "localhost" quando o
# cloudflared roda no host (padrão destes scripts).
CF_TUNNEL_HOST=localhost

###########################################################
# EMAIL
###########################################################

# Escolha entre resend e smtp
EMAIL_TYPE=resend

###########################################################
# SMTP
###########################################################

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=smart-option-contact@byissa.dev
SMTP_PASSWORD=dev-placeholder-sem-credencial-real

###########################################################
# RESEND
###########################################################

RESEND_API_KEY=dev-placeholder-sem-api-key

MAIL_FROM_NAME=Smart Option

MAIL_FROM_ADDRESS=smart-option@byissa.dev